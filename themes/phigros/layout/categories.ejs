<%
  var allPosts = site.posts.toArray();
  var categoryConfigs = (theme.saturn && theme.saturn.categories) || {};
  var fallbackCover = (theme.saturn && theme.saturn.category_fallback_cover) || '/images/category-default.jpg';

  function resolveCategoryId(value) {
    var key = String(value == null ? '' : value).trim();
    if (!key) return '';
    if (categoryConfigs[key]) return key;
    var found = '';
    Object.keys(categoryConfigs).some(function(id) {
      var cfg = categoryConfigs[id] || {};
      if (String(cfg.name || '').trim() === key) {
        found = id;
        return true;
      }
      return false;
    });
    return found || key;
  }

  var categoryMap = {};
  allPosts.forEach(function(post) {
    var pcs = (post.categories && typeof post.categories.toArray === 'function') ? post.categories.toArray() : [];
    pcs.forEach(function(cat) {
      var id = resolveCategoryId(cat && cat.name);
      if (!id) return;
      if (!categoryMap[id]) categoryMap[id] = { id: id, posts: [] };
      categoryMap[id].posts.push(post);
    });
  });

  Object.keys(categoryMap).forEach(function(id) {
    categoryMap[id].posts.sort(function(a, b) { return b.date - a.date; });
    categoryMap[id].length = categoryMap[id].posts.length;
  });

  var categoryIds = Object.keys(categoryMap);
  categoryIds.sort(function(a, b) {
    return categoryMap[b].length - categoryMap[a].length || a.localeCompare(b);
  });

  var configuredIds = Object.keys(categoryConfigs);
  var visibleCount = configuredIds.length + categoryIds.filter(function(id) { return !categoryConfigs[id]; }).length;
%>

<div class="phi-collection-page">
  <div class="phi-collection-shell">
    <div class="phi-collection-topbar">
      <span class="phi-collection-tab" data-i18n="collection.tab">//COLLECTION</span>
      <span class="phi-collection-status" data-i18n="category.database">CATEGORY_DATABASE</span>
    </div>
    <div class="phi-collection-body">
      <div class="phi-collection-heading">
        <span class="phi-collection-heading__label" data-i18n="category.label">CATEGORY</span>
        <h1 data-i18n="category.collection">COLLECTION</h1>
        <p><span data-i18n-number="category.foldersAvailable" data-i18n-count="<%= visibleCount %>"><%= visibleCount %> folders available</span></p>
      </div>

      <div class="phi-collection-grid">
        <% configuredIds.forEach(function(id) {
          var cfg = categoryConfigs[id] || {};
          var posts = categoryMap[id] ? categoryMap[id].posts : [];
          var cover = cfg.cover || fallbackCover;
          var cardTitle = cfg.name || cfg.title || id;
        %>
          <% if (posts.length) { %>
            <a class="phi-collection-card" href="<%- url_for(posts[0].path) %>">
              <div class="phi-collection-card__media"><img src="<%- url_for(cover) %>" alt="" loading="lazy" onerror="this.onerror=null;this.src='<%- url_for(fallbackCover) %>';"><div class="phi-collection-card__shade"></div><div class="phi-collection-card__text"><strong><%= cardTitle %></strong><small data-i18n-number="collection.files" data-i18n-count="<%= posts.length %>"><%= posts.length %> FILES</small></div></div>
            </a>
          <% } else { %>
            <div class="phi-collection-card is-disabled" aria-disabled="true">
              <div class="phi-collection-card__media is-empty"><img src="<%- url_for(cover) %>" alt="" loading="lazy" onerror="this.onerror=null;this.src='<%- url_for(fallbackCover) %>';"><div class="phi-collection-card__disabled-veil"></div><div class="phi-collection-card__text"><strong><%= cardTitle %></strong><small data-i18n-number="collection.files" data-i18n-count="0">0 FILES</small></div></div>
            </div>
          <% } %>
        <% }); %>

        <% categoryIds.forEach(function(id) {
          if (categoryConfigs[id]) return;
          var posts = categoryMap[id].posts;
          var cardTitle = id;
          var cover = fallbackCover;
        %>
          <% if (posts.length) { %>
            <a class="phi-collection-card" href="<%- url_for(posts[0].path) %>">
              <div class="phi-collection-card__media"><img src="<%- url_for(cover) %>" alt="" loading="lazy"><div class="phi-collection-card__shade"></div><div class="phi-collection-card__text"><strong><%= cardTitle %></strong><small data-i18n-number="collection.files" data-i18n-count="<%= posts.length %>"><%= posts.length %> FILES</small></div></div>
            </a>
          <% } %>
        <% }); %>
      </div>
    </div>
  </div>
</div>
