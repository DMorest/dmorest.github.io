<%
  var categoryConfigs = (theme.saturn && theme.saturn.categories) || {};
  function resolveCategoryId(value) {
    var key = String(value == null ? '' : value).trim();
    if (!key) return '';
    if (categoryConfigs[key]) return key;
    var found = '';
    Object.keys(categoryConfigs).some(function(id) {
      var cfg = categoryConfigs[id] || {};
      if (String(cfg.name || '').trim() === key) { found = id; return true; }
      return false;
    });
    return found || key;
  }

  var categoryId = resolveCategoryId(page.category_id || page.category_name || page.title);
  var cfg = categoryConfigs[categoryId] || {};
  var posts = [];
  site.posts.toArray().forEach(function(post) {
    var pcs = (post.categories && typeof post.categories.toArray === 'function') ? post.categories.toArray() : [];
    var matched = false;
    pcs.forEach(function(cat) {
      if (resolveCategoryId(cat && cat.name) === categoryId) matched = true;
    });
    if (matched) posts.push(post);
  });
  posts.sort(function(a, b) { return b.date - a.date; });
%>

<div class="phi-collection-page phi-core-category-page">
  <div class="phi-collection-shell">
    <div class="phi-collection-topbar">
      <span class="phi-collection-tab">//COLLECTION</span>
      <span class="phi-collection-status" data-i18n="folder.content">FOLDER_CONTENT</span>
    </div>
    <div class="phi-collection-body">
      <div class="phi-collection-heading phi-collection-heading--category">
        <span class="phi-collection-heading__label" data-i18n="folder.information">FOLDER_INFORMATION</span>
        <h1><%= cfg.name || cfg.title || categoryId %></h1>
        <p><%= posts.length %> FILES</p>
      </div>
      <div class="phi-collection-filelist">
        <% if (!posts.length) { %><div class="phi-collection-empty" data-i18n="collection.noFiles">NO FILES CONNECTED.</div><% } %>
        <% posts.forEach(function(post, i) { %>
          <a class="phi-collection-file" href="<%- url_for(post.path) %>">
            <span class="phi-collection-file__index"><%= String(i + 1).padStart(2, '0') %></span>
            <span class="phi-collection-file__date"><%= date(post.date, 'YYYY.MM.DD') %></span>
            <span class="phi-collection-file__title"><%= post.title %></span>
            <span class="phi-collection-file__arrow">›</span>
          </a>
        <% }); %>
      </div>
    </div>
  </div>
</div>
