<%
  /* ==========================================================
     Saturn Virtual OS / PhigrOS file viewer
     Category IDs are English internally; name is the external label.
     ========================================================== */
  var analysis = Number(page.analysis);
  if (!isFinite(analysis)) analysis = 100;
  analysis = Math.max(0, Math.min(100, analysis));

  var analysisStatus = analysis >= 100 ? 'ANALYZATION COMPLETE.' : (analysis + '% ANALYZED.');

  var commentFlag = String(page.comments == null ? '' : page.comments).trim().toLowerCase();
  var commentsEnabled = !(commentFlag === 'false' || commentFlag === '0' || commentFlag === 'no') && (!theme.comments || theme.comments.enable !== false);

  var supervisor = page.supervisor || (config.author || 'D.O.M.E');
  var pageCategories = (page.categories && typeof page.categories.toArray === 'function') ? page.categories.toArray() : [];

  var categoryConfigs = (theme.saturn && theme.saturn.categories) || {};
  var folderDefaults = (theme.saturn && theme.saturn.folder_defaults) || {};

  /* Pin flags support explicit front-matter fields and a compact nested form. */
  function isPinEnabled(post, target) {
    if (!post) return false;
    var nested = post.pin && typeof post.pin === 'object' ? post.pin[target] : false;
    var value = post['pin_' + target] != null ? post['pin_' + target] : nested;
    if (value == null) return false;
    return value === true || value === 1 || /^(true|1|yes|on)$/i.test(String(value).trim());
  }

  /* Resolve both the new English internal ID and the legacy external name. */
  function resolveCategoryId(value) {
    var key = String(value == null ? '' : value).trim();
    if (!key) return '';
    if (categoryConfigs[key]) return key;
    var found = '';
    Object.keys(categoryConfigs).some(function(id) {
      var cfg = categoryConfigs[id] || {};
      if (String(cfg.name || '').trim() === key) {
        found = id;
        return true;
      }
      return false;
    });
    return found || key;
  }

  function getCategoryConfig(value) {
    var id = resolveCategoryId(value);
    return id && categoryConfigs[id] ? categoryConfigs[id] : {};
  }

  var primaryCategoryRaw = pageCategories.length ? pageCategories[0].name : '';
  var primaryCategory = resolveCategoryId(primaryCategoryRaw);
  var categoryConfig = getCategoryConfig(primaryCategory);
  var categoryLabel = page.category_label;
  if (categoryLabel) {
    var manualLabelId = resolveCategoryId(categoryLabel);
    if (categoryConfigs[manualLabelId] && categoryConfigs[manualLabelId].name) {
      categoryLabel = categoryConfigs[manualLabelId].name;
    }
  } else {
    categoryLabel = categoryConfig.name || primaryCategory || (theme.saturn && theme.saturn.category_default) || 'main';
  }

  var rawFolder = page.folder;
  var folderConfig = (rawFolder && typeof rawFolder === 'object' && !Array.isArray(rawFolder)) ? rawFolder : {};

  /* Explicit per-post folder settings outrank category defaults. */
  var folderCategory = resolveCategoryId(folderConfig.category || page.folder_category || primaryCategory || '');
  var selectedCategoryConfig = getCategoryConfig(folderCategory);
  var selectedFolderDefault = folderCategory && folderDefaults[folderCategory] ? folderDefaults[folderCategory] : {};

  var folderTitle = folderConfig.title || page.folder_title || selectedCategoryConfig.title || selectedCategoryConfig.name || selectedFolderDefault.title || selectedFolderDefault.name || folderCategory || page.title;
  var folderCompletion = Number(folderConfig.completion != null ? folderConfig.completion : (page.folder_completion != null ? page.folder_completion : (selectedCategoryConfig.completion != null ? selectedCategoryConfig.completion : selectedFolderDefault.completion)));
  if (!isFinite(folderCompletion)) folderCompletion = 100;
  folderCompletion = Math.max(0, Math.min(100, folderCompletion));

  /* A categorized article uses that category's cover by default. */
  var folderCover = folderConfig.cover || page.folder_cover || selectedCategoryConfig.cover || selectedFolderDefault.cover || page.cover || page.thumbnail || '';
  var explicitFolderPosts = Array.isArray(folderConfig.posts) ? folderConfig.posts : (Array.isArray(page.folder_posts) ? page.folder_posts : null);
  var folderEntries = [];
  var hasUsableCategory = !!primaryCategory;

  /* Collect folder entries first; pin_folder entries are ordered before the
     remaining articles, with date order preserved inside each group. */
  site.posts.sort('date', -1).each(function(p) {
    if (explicitFolderPosts) {
      var match = explicitFolderPosts.indexOf(p.slug) !== -1 || explicitFolderPosts.indexOf(p.path) !== -1 || explicitFolderPosts.indexOf(p.title) !== -1;
      if (match) folderEntries.push(p);
      return;
    }

    if (folderCategory && hasUsableCategory) {
      var sameCategory = false;
      var postCategories = (p.categories && typeof p.categories.toArray === 'function') ? p.categories.toArray() : [];
      postCategories.forEach(function(cat) {
        if (resolveCategoryId(cat.name) === folderCategory) sameCategory = true;
      });
      if (!sameCategory) return;
      folderEntries.push(p);
      return;
    }
  });

  /* Uncategorized articles keep a one-item folder. Explicit folders always
     retain the current article even when folder.posts omitted it. */
  if (!hasUsableCategory && !explicitFolderPosts) {
    folderEntries = [page];
  } else if (explicitFolderPosts && !folderEntries.some(function(p) { return p.path === page.path; })) {
    folderEntries.push(page);
  }

  folderEntries.sort(function(a, b) {
    var ap = isPinEnabled(a, 'folder') ? 1 : 0;
    var bp = isPinEnabled(b, 'folder') ? 1 : 0;
    if (ap !== bp) return bp - ap;
    var ad = new Date(a.date || 0).getTime();
    var bd = new Date(b.date || 0).getTime();
    return bd - ad;
  });

  /* Keep the compact folder UI at a maximum of 10 visible entries. */
  folderEntries = folderEntries.slice(0, 10);

  var folderItemsDefault = folderEntries.length;
  var folderItems = Number(folderConfig.items != null ? folderConfig.items : (page.folder_items != null ? page.folder_items : (selectedCategoryConfig.items != null ? selectedCategoryConfig.items : selectedFolderDefault.items)));
  if (!isFinite(folderItems)) folderItems = folderItemsDefault || 1;
  folderItems = Math.max(1, folderItems);
%>

<article class="phi-file-view<%= commentsEnabled ? "" : " is-comments-closed" %>">
  <button class="phi-folder-mobile-toggle" type="button" aria-expanded="false" aria-controls="phi-folder-panel">FOLDER</button>
  <button class="phi-folder-mobile-scrim" type="button" aria-label="Close folder" tabindex="-1"></button>
  <aside class="phi-folder-panel" id="phi-folder-panel">
    <div class="phi-folder-head">
      <span data-i18n="folder.information">FOLDER_INFORMATION</span>
      <button class="phi-folder-mobile-close" type="button" aria-label="Close folder" title="Close folder">×</button>
    </div>

    <div class="phi-folder-cover<%= folderCover ? '' : ' is-empty' %>">
      <% if (folderCover) { %>
        <img src="<%- url_for(folderCover) %>" alt="">
      <% } %>
      <div class="phi-folder-cover__shade"></div>
      <div class="phi-folder-cover__info">
        <strong><%= folderTitle %></strong>
        <span>Completion <%= folderCompletion %>%</span>
      </div>
      <div class="phi-folder-cover__line" style="width:<%= folderCompletion %>%"></div>
    </div>

    <div class="phi-folder-section" data-i18n="folder.section">CONTENT</div>
    <nav class="phi-folder-list" aria-label="Folder contents">
      <% folderEntries.forEach(function(item) { %>
        <a class="phi-folder-item<%= item.path === page.path ? ' is-current' : '' %><%= isPinEnabled(item, 'folder') ? ' is-pinned' : '' %>" href="<%- url_for(item.path) %>">
          <span><%= item.title %></span>
        </a>
      <% }); %>
    </nav>

    <div class="phi-folder-footer">
      <span><%= Math.min(folderItems, folderEntries.length) %>/<%= folderItems %></span>
      <a href="#" data-phi-back>&lt; <span>BACK</span></a>
    </div>
  </aside>

  <section class="phi-file-panel">
    <div class="phi-file-topbar" style="--analysis-progress:<%= analysis %>%" aria-label="<%= analysisStatus %>">
      <div class="phi-file-tab">FILE_CONTENT</div>
      <div class="phi-analysis-status">
        <span><%= analysisStatus %></span>
      </div>
    </div>

    <header class="phi-file-header">
      <h1><%= page.title %></h1>
      <div class="phi-file-meta">
        <span class="phi-file-meta__label" data-i18n="post.date">DATE</span>
        <span class="phi-file-meta__value"><%= date(page.date, 'YYYY/MM/DD') %></span>
        <span class="phi-file-meta__label" data-i18n="post.supervisor">SUPERVISOR</span>
        <span class="phi-file-meta__value"><%= supervisor %></span>
        <span class="phi-file-meta__label" data-i18n="post.category">CATEGORY</span>
        <span class="phi-file-meta__value"><%= categoryLabel %></span>
      </div>
      <div class="phi-file-rule"></div>
    </header>

    <div class="phi-file-content">
      <%- page.content %>
    </div>

    <% if (theme.post.show_prev_next !== false && (page.prev || page.next)) { %>
    <nav class="phi-file-nav">
      <% if (page.prev) { %>
        <a href="<%- url_for(page.prev.path) %>">
          <span>&lt;&lt; PREVIOUS FILE</span>
          <strong><%= page.prev.title %></strong>
        </a>
      <% } else { %><span></span><% } %>
      <% if (page.next) { %>
        <a href="<%- url_for(page.next.path) %>" class="is-next">
          <span>NEXT FILE &gt;&gt;</span>
          <strong><%= page.next.title %></strong>
        </a>
      <% } %>
    </nav>
    <% } %>

    <div class="phi-file-stats" aria-label="Page views">
      <span class="waline-pageview-count" aria-live="polite">—</span> VIEWS
    </div>

    <%- partial('_partial/waline') %>
  </section>
</article>
